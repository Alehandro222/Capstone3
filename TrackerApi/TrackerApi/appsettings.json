{
  "ConnectionStrings": {
    "Default": "Data Source=tracker.db"
  },
  "Tracker": {
    "VisitLifetimeHours": 12,
    "PassLifetimeMinutes": 10,
    "SessionMinutes": 180,
    "ExtensionMinutes": 60,
    "MaxExtensions": 2,
    "ExtendWindowMinutes": 10,
    "OfflineAfterSeconds": 30,
    "RequireHeartbeat": true,
    "WaitlistLifetimeMinutes": 240,
    "WaitlistOfferMinutes": 5,
    "CleanupIntervalSeconds": 15,
    "TimeZone": "Asia/Manila",
    "KeepVisitsDays": 365
  },
  "Backup": {
    "Enabled": true,
    "Folder": "backups",
    "KeepDays": 30
  },
  "Hosting": {
    "TrustedProxyHops": 0,
    "ProxySignatureSecret": "",
    "RequireHttps": false
  },
  "Gemini": {
    "ApiKey": "",
    "Model": "gemini-2.5-flash",
    "TimeoutSeconds": 90
  },
  "RateLimits": {
    "Enabled": true,
    "SignInPerMinute": 10,
    "RegistrationsPer10Minutes": 6,
    "PassesPer10Minutes": 6,
    "WaitlistJoinsPer10Minutes": 5,
    "PairingPerMinute": 10
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  },
  "AllowedHosts": "*"
}
