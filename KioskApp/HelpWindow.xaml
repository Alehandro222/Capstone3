<Window x:Class="KioskApp.HelpWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Ask for help"
        Width="440" SizeToContent="Height"
        ResizeMode="NoResize" WindowStartupLocation="CenterOwner"
        Topmost="True" ShowInTaskbar="False"
        Background="{StaticResource SurfaceBrush}"
        Foreground="{StaticResource TextBrush}"
        FontFamily="Segoe UI" FontSize="15">

    <StackPanel Margin="20">
        <TextBlock Text="How can we help?" FontSize="20" FontWeight="Bold" Margin="0,0,0,10"/>
        <TextBox x:Name="HelpText" Height="110" FontSize="16" MaxLength="500"
                 AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"/>
        <TextBlock x:Name="HelpError" Foreground="{StaticResource DangerBrush}" Margin="0,8,0,0"/>

        <Grid Margin="0,14,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="10"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Button Grid.Column="0" Content="Cancel" Style="{StaticResource BaseButton}"
                    MinHeight="42" FontSize="15" Padding="12,6" Click="Cancel_Click"/>
            <Button Grid.Column="2" Content="Send request" Style="{StaticResource PrimaryButton}"
                    MinHeight="42" FontSize="15" Padding="12,6" Click="Send_Click"/>
        </Grid>
    </StackPanel>
</Window>
