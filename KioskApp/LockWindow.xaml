<Window x:Class="KioskApp.LockWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Public Computer Station"
        Width="1100" Height="760" MinWidth="720" MinHeight="680"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BgBrush}"
        Foreground="{StaticResource TextBrush}"
        FontFamily="Segoe UI" FontSize="16"
        PreviewKeyDown="Window_PreviewKeyDown"
        Closing="Window_Closing"
        Closed="Window_Closed">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Top bar -->
        <Border Grid.Row="0"
                Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,0,0,1"
                Padding="24,14">
            <Grid>
                <TextBlock x:Name="ComputerNameText" FontSize="18" FontWeight="Bold" HorizontalAlignment="Left"/>
                <TextBlock Text="Public Computer Station" Foreground="{StaticResource MutedBrush}" HorizontalAlignment="Right"/>
            </Grid>
        </Border>

        <!-- Shown when the tracker cannot be reached -->
        <Border x:Name="OfflineBanner" Grid.Row="1" Background="{StaticResource DangerBgBrush}" Padding="16,10" Visibility="Collapsed">
            <TextBlock Text="Connection lost. Trying to reconnect…" Foreground="{StaticResource DangerBrush}" HorizontalAlignment="Center"/>
        </Border>

        <!-- The card in the middle. Only one panel inside it is visible at a time. -->
        <Border Grid.Row="2"
                Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="16"
                Padding="32"
                MinWidth="560" MaxWidth="700"
                HorizontalAlignment="Center" VerticalAlignment="Center">
            <Grid>

                <!-- Simple messages: loading, out of service, thank you... -->
                <StackPanel x:Name="MessagePanel" Visibility="Collapsed" Margin="0,24">
                    <TextBlock x:Name="MessageTitle" FontSize="34" FontWeight="Bold" TextAlignment="Center" TextWrapping="Wrap"/>
                    <TextBlock x:Name="MessageText" FontSize="20" Foreground="{StaticResource MutedBrush}"
                               TextAlignment="Center" TextWrapping="Wrap" Margin="0,12,0,0"/>
                </StackPanel>

                <!-- Login -->
                <StackPanel x:Name="LoginPanel" Visibility="Collapsed">
                    <TextBlock Text="Welcome" FontSize="34" FontWeight="Bold"/>
                    <TextBlock x:Name="LoginIntro" FontSize="20" Foreground="{StaticResource MutedBrush}" Margin="0,4,0,20"/>

                    <TextBlock Text="Your full name" FontWeight="Medium" Margin="0,0,0,6"/>
                    <TextBox x:Name="NameBox" MaxLength="100" KeyDown="Login_KeyDown"/>

                    <TextBlock Text="What will you use the computer for?" FontWeight="Medium" Margin="0,20,0,8"/>
                    <WrapPanel x:Name="PurposePanel">
                        <RadioButton GroupName="Purpose" Content="Job application" Style="{StaticResource ChipRadio}" Checked="Purpose_Checked"/>
                        <RadioButton GroupName="Purpose" Content="School work or research" Style="{StaticResource ChipRadio}" Checked="Purpose_Checked"/>
                        <RadioButton GroupName="Purpose" Content="Government forms &amp; services" Style="{StaticResource ChipRadio}" Checked="Purpose_Checked"/>
                        <RadioButton GroupName="Purpose" Content="Printing or documents" Style="{StaticResource ChipRadio}" Checked="Purpose_Checked"/>
                        <RadioButton GroupName="Purpose" Content="Online meeting or class" Style="{StaticResource ChipRadio}" Checked="Purpose_Checked"/>
                        <RadioButton GroupName="Purpose" Content="Other" Style="{StaticResource ChipRadio}" Checked="Purpose_Checked"/>
                    </WrapPanel>
                    <TextBox x:Name="OtherBox" MaxLength="200" Visibility="Collapsed" Margin="0,0,0,8" KeyDown="Login_KeyDown"/>

                    <TextBlock x:Name="LoginError" Foreground="{StaticResource DangerBrush}" TextWrapping="Wrap" Margin="0,4,0,0"/>
                    <TextBlock x:Name="LoginNotice" Visibility="Collapsed" Foreground="{StaticResource OkBrush}"
                               TextWrapping="Wrap" Margin="0,4,0,0"/>

                    <Button x:Name="LoginButton" Content="Log in and start" Style="{StaticResource PrimaryButton}"
                            Margin="0,12,0,0" Click="LoginButton_Click"/>
                    <Button x:Name="LoginHelpButton" Content="Need help?" Style="{StaticResource BaseButton}"
                            Margin="0,10,0,0" Click="LoginHelp_Click"/>
                    <TextBlock Text="Your name and purpose are recorded to help the office manage computer use."
                               FontSize="13" Foreground="{StaticResource MutedBrush}"
                               TextAlignment="Center" TextWrapping="Wrap" Margin="0,14,0,0"/>
                </StackPanel>

                <!-- Setup: staff choose which computer this is -->
                <StackPanel x:Name="SetupPanel" Visibility="Collapsed">
                    <TextBlock Text="Set up this computer" FontSize="30" FontWeight="Bold"/>
                    <TextBlock Text="Staff: choose which computer in the tracker this is." FontSize="18"
                               Foreground="{StaticResource MutedBrush}" Margin="0,4,0,0"/>
                    <ListBox x:Name="ComputerList" DisplayMemberPath="Name" FontSize="20" Height="240"
                             BorderThickness="2" BorderBrush="{StaticResource BorderBrush}" Margin="0,16,0,8"/>
                    <TextBlock x:Name="SetupError" Foreground="{StaticResource DangerBrush}" TextWrapping="Wrap" Margin="0,0,0,8"/>
                    <Button Content="Use this computer" Style="{StaticResource PrimaryButton}" Click="SetupButton_Click"/>
                </StackPanel>

                <!-- Staff PIN (Ctrl+Shift+Q) -->
                <StackPanel x:Name="StaffPinPanel" Visibility="Collapsed">
                    <TextBlock Text="Staff only" FontSize="30" FontWeight="Bold"/>
                    <TextBlock Text="Enter the staff PIN." FontSize="18" Foreground="{StaticResource MutedBrush}" Margin="0,4,0,16"/>
                    <PasswordBox x:Name="PinBox" KeyDown="PinBox_KeyDown"/>
                    <TextBlock x:Name="PinError" Foreground="{StaticResource DangerBrush}" Margin="0,8,0,0"/>
                    <Grid Margin="0,16,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0" Content="Cancel" Style="{StaticResource BaseButton}" Click="StaffCancel_Click"/>
                        <Button Grid.Column="2" Content="Unlock" Style="{StaticResource PrimaryButton}" Click="PinOk_Click"/>
                    </Grid>
                </StackPanel>

                <!-- Staff menu -->
                <StackPanel x:Name="StaffMenuPanel" Visibility="Collapsed">
                    <TextBlock Text="Staff menu" FontSize="30" FontWeight="Bold" Margin="0,0,0,16"/>
                    <Button Content="Change which computer this is" Style="{StaticResource BaseButton}" Click="ChangeComputer_Click" Margin="0,0,0,12"/>
                    <Button Content="Exit the kiosk" Style="{StaticResource DangerButton}" Click="ExitKiosk_Click" Margin="0,0,0,12"/>
                    <Button Content="Back" Style="{StaticResource BaseButton}" Click="StaffCancel_Click"/>
                </StackPanel>

            </Grid>
        </Border>
    </Grid>
</Window>
