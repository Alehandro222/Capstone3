<Window x:Class="KioskApp.LockWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Public Computer Station"
        Width="1100" Height="760" MinWidth="720" MinHeight="680"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BgBrush}"
        Foreground="{StaticResource TextBrush}"
        FontFamily="Segoe UI" FontSize="16"
        PreviewKeyDown="Window_PreviewKeyDown"
        Closing="Window_Closing"
        Closed="Window_Closed">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Top bar -->
        <Border Grid.Row="0"
                Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,0,0,1"
                Padding="24,14">
            <Grid>
                <TextBlock x:Name="ComputerNameText" FontSize="18" FontWeight="Bold" HorizontalAlignment="Left"/>
                <TextBlock Text="Public Computer Station" Foreground="{StaticResource MutedBrush}" HorizontalAlignment="Right"/>
            </Grid>
        </Border>

        <!-- Shown when the tracker cannot be reached -->
        <Border x:Name="OfflineBanner" Grid.Row="1" Background="{StaticResource DangerBgBrush}" Padding="16,10" Visibility="Collapsed">
            <TextBlock Text="Connection lost. Trying to reconnect…" Foreground="{StaticResource DangerBrush}" HorizontalAlignment="Center"/>
        </Border>

        <!-- The card in the middle. Only one panel inside it is visible at a time. -->
        <Border Grid.Row="2"
                Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="16"
                Padding="32"
                MinWidth="560" MaxWidth="900"
                HorizontalAlignment="Center" VerticalAlignment="Center">
            <Grid>

                <!-- Simple messages: loading, out of service, thank you... -->
                <StackPanel x:Name="MessagePanel" Visibility="Collapsed" Margin="0,24">
                    <TextBlock x:Name="MessageTitle" FontSize="34" FontWeight="Bold" TextAlignment="Center" TextWrapping="Wrap"/>
                    <TextBlock x:Name="MessageText" FontSize="20" Foreground="{StaticResource MutedBrush}"
                               TextAlignment="Center" TextWrapping="Wrap" Margin="0,12,0,0"/>
                </StackPanel>

                <!-- Available: how visitors get this PC (they register on their phone) -->
                <Grid x:Name="LoginPanel" Visibility="Collapsed">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" MaxWidth="560">
                        <TextBlock Text="Welcome" FontSize="34" FontWeight="Bold"/>
                        <TextBlock x:Name="LoginIntro" FontSize="20" Foreground="{StaticResource MutedBrush}" Margin="0,4,0,20" TextWrapping="Wrap"/>
                        <TextBlock x:Name="LoginSteps" FontSize="18" TextWrapping="Wrap" LineHeight="28"/>
                        <TextBlock Text="No phone? Ask the staff at the help desk to register you."
                                   FontSize="16" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,16,0,0"/>

                        <TextBlock x:Name="LoginError" Foreground="{StaticResource DangerBrush}" TextWrapping="Wrap" Margin="0,8,0,0"/>
                        <TextBlock x:Name="LoginNotice" Visibility="Collapsed" Foreground="{StaticResource OkBrush}"
                                   TextWrapping="Wrap" Margin="0,4,0,0"/>
                        <Button x:Name="LoginHelpButton" Content="Need help?" Style="{StaticResource BaseButton}"
                                HorizontalAlignment="Left" Margin="0,16,0,0" Click="LoginHelp_Click"/>
                    </StackPanel>

                    <!-- QR code: opens the phone app with this PC already chosen (only when visitorUrl is set) -->
                    <Border x:Name="QrBox" Grid.Column="1" Visibility="Collapsed" Margin="28,0,0,0" VerticalAlignment="Center"
                            BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="12" Padding="14">
                        <StackPanel>
                            <Image x:Name="QrImage" Width="220" Height="220" RenderOptions.BitmapScalingMode="NearestNeighbor"/>
                            <TextBlock x:Name="QrCaption" FontSize="15" FontWeight="SemiBold" TextAlignment="Center"
                                       TextWrapping="Wrap" MaxWidth="220" Margin="0,8,0,0"/>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- Reserved: a visitor picked this PC and is on the way to the help desk -->
                <StackPanel x:Name="ReservedPanel" Visibility="Collapsed" Margin="0,16">
                    <TextBlock Text="Reserved" FontSize="34" FontWeight="Bold" TextAlignment="Center"/>
                    <TextBlock FontSize="20" Foreground="{StaticResource MutedBrush}" TextAlignment="Center" TextWrapping="Wrap" Margin="0,12,0,0"
                               Text="Someone picked this computer on their phone. It unlocks when staff scan their QR pass at the help desk."/>
                    <TextBlock x:Name="ReservedCountdown" FontFamily="Consolas" FontSize="44" FontWeight="Bold"
                               TextAlignment="Center" Margin="0,20,0,0"/>
                    <TextBlock x:Name="ReservedCountdownLabel" FontSize="16" Foreground="{StaticResource MutedBrush}" TextAlignment="Center"
                               Text="left to check in. If nobody does, this computer becomes free again."/>
                    <TextBlock FontSize="16" Foreground="{StaticResource MutedBrush}" TextAlignment="Center" TextWrapping="Wrap" Margin="0,20,0,0"
                               Text="Is this your reservation? Show your QR pass at the help desk. Otherwise, please pick another computer."/>
                </StackPanel>

                <!-- Staff only (from the staff menu): register a visitor right here, e.g. one whose phone died -->
                <ScrollViewer x:Name="RegisterPanel" Visibility="Collapsed" MaxHeight="560" VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="Register a visitor" FontSize="28" FontWeight="Bold"/>
                        <TextBlock Text="Staff only. The session starts on this computer as soon as you save."
                                   Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,4,0,14"/>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="First name" FontWeight="Medium" Margin="0,0,0,4"/>
                                <TextBox x:Name="FirstNameBox" MaxLength="100"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Last name" FontWeight="Medium" Margin="0,0,0,4"/>
                                <TextBox x:Name="LastNameBox" MaxLength="100"/>
                            </StackPanel>
                        </Grid>

                        <TextBlock Text="Age" FontWeight="Medium" Margin="0,14,0,6"/>
                        <WrapPanel x:Name="AgePanel">
                            <RadioButton GroupName="Age" Tag="Age17AndUnder" Content="17 &amp; under" Style="{StaticResource SmallChipRadio}"/>
                            <RadioButton GroupName="Age" Tag="Age18To30" Content="18 – 30" Style="{StaticResource SmallChipRadio}"/>
                            <RadioButton GroupName="Age" Tag="Age31To59" Content="31 – 59" Style="{StaticResource SmallChipRadio}"/>
                            <RadioButton GroupName="Age" Tag="Age60AndAbove" Content="60 &amp; above" Style="{StaticResource SmallChipRadio}"/>
                        </WrapPanel>

                        <TextBlock Text="Sex" FontWeight="Medium" Margin="0,6,0,6"/>
                        <WrapPanel x:Name="SexPanel">
                            <RadioButton GroupName="Sex" Tag="Male" Content="Male" Style="{StaticResource SmallChipRadio}"/>
                            <RadioButton GroupName="Sex" Tag="Female" Content="Female" Style="{StaticResource SmallChipRadio}"/>
                        </WrapPanel>

                        <TextBlock Text="Sector (select all that apply)" FontWeight="Medium" Margin="0,6,0,6"/>
                        <WrapPanel x:Name="SectorPanel">
                            <CheckBox Tag="Nga" Content="NGA" Style="{StaticResource ChipCheck}"/>
                            <CheckBox Tag="Lgu" Content="LGU" Style="{StaticResource ChipCheck}"/>
                            <CheckBox Tag="Academe" Content="Academe" Style="{StaticResource ChipCheck}"/>
                            <CheckBox Tag="Youth" Content="Youth" Style="{StaticResource ChipCheck}"/>
                            <CheckBox Tag="SeniorCitizen" Content="Senior Citizen" Style="{StaticResource ChipCheck}"/>
                            <CheckBox Tag="Msme" Content="MSMEs" Style="{StaticResource ChipCheck}"/>
                            <CheckBox Tag="IndigenousPeople" Content="Indigenous People" Style="{StaticResource ChipCheck}"/>
                            <CheckBox Tag="Pwd" Content="PWD" Style="{StaticResource ChipCheck}"/>
                            <CheckBox Tag="InformalSector" Content="Informal Sector" Style="{StaticResource ChipCheck}"/>
                            <CheckBox Tag="Others" Content="Others" Style="{StaticResource ChipCheck}"/>
                        </WrapPanel>

                        <TextBlock Text="Purpose / services availed (select all that apply)" FontWeight="Medium" Margin="0,6,0,6"/>
                        <WrapPanel x:Name="ServicePanel">
                            <CheckBox Tag="Connectivity" Content="Connectivity" Style="{StaticResource ChipCheck}"/>
                            <CheckBox Tag="IctEquipment" Content="Use of ICT Equipment" Style="{StaticResource ChipCheck}"/>
                            <CheckBox Tag="CoWorkingSpace" Content="Co-Working Space" Style="{StaticResource ChipCheck}"/>
                            <CheckBox Tag="EgovServices" Content="eGov Services" Style="{StaticResource ChipCheck}"/>
                            <CheckBox Tag="Others" Content="Others" Style="{StaticResource ChipCheck}"/>
                        </WrapPanel>

                        <TextBlock FontSize="12" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,6,0,0"
                                   Text="Privacy: the visitor's details are used by DICT-CAR only for registration, in compliance with the Data Privacy Act of 2012. Read the full statement to them if they ask."/>

                        <TextBlock x:Name="RegisterError" Foreground="{StaticResource DangerBrush}" TextWrapping="Wrap" Margin="0,8,0,0"/>
                        <Grid Margin="0,12,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="2*"/>
                            </Grid.ColumnDefinitions>
                            <Button Grid.Column="0" Content="Cancel" Style="{StaticResource BaseButton}" Click="StaffCancel_Click"/>
                            <Button Grid.Column="2" x:Name="RegisterButton" Content="Register and start"
                                    Style="{StaticResource PrimaryButton}" Click="RegisterButton_Click"/>
                        </Grid>
                    </StackPanel>
                </ScrollViewer>

                <!-- Setup: staff choose which computer this is -->
                <StackPanel x:Name="SetupPanel" Visibility="Collapsed">
                    <TextBlock Text="Set up this computer" FontSize="30" FontWeight="Bold"/>
                    <TextBlock FontSize="18" Foreground="{StaticResource MutedBrush}" Margin="0,4,0,0" TextWrapping="Wrap"
                               Text="Staff: an admin creates a pairing code for this PC in the dashboard. Type it here."/>
                    <TextBox x:Name="PairingCodeBox" FontSize="28" Margin="0,16,0,8" CharacterCasing="Upper"
                             MaxLength="12" KeyDown="PairingCodeBox_KeyDown"/>
                    <TextBlock x:Name="SetupError" Foreground="{StaticResource DangerBrush}" TextWrapping="Wrap" Margin="0,0,0,8"/>
                    <Button Content="Pair this computer" Style="{StaticResource PrimaryButton}" Click="SetupButton_Click"/>
                </StackPanel>

                <!-- Staff PIN (Ctrl+Shift+Q) -->
                <StackPanel x:Name="StaffPinPanel" Visibility="Collapsed">
                    <TextBlock Text="Staff only" FontSize="30" FontWeight="Bold"/>
                    <TextBlock Text="Enter the staff PIN." FontSize="18" Foreground="{StaticResource MutedBrush}" Margin="0,4,0,16"/>
                    <PasswordBox x:Name="PinBox" KeyDown="PinBox_KeyDown"/>
                    <TextBlock x:Name="PinError" Foreground="{StaticResource DangerBrush}" Margin="0,8,0,0"/>
                    <Grid Margin="0,16,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0" Content="Cancel" Style="{StaticResource BaseButton}" Click="StaffCancel_Click"/>
                        <Button Grid.Column="2" Content="Unlock" Style="{StaticResource PrimaryButton}" Click="PinOk_Click"/>
                    </Grid>
                </StackPanel>

                <!-- Staff menu -->
                <StackPanel x:Name="StaffMenuPanel" Visibility="Collapsed">
                    <TextBlock Text="Staff menu" FontSize="30" FontWeight="Bold" Margin="0,0,0,16"/>
                    <Button Content="Register a visitor on this computer" Style="{StaticResource PrimaryButton}" Click="RegisterVisitor_Click" Margin="0,0,0,12"/>
                    <TextBlock x:Name="StaffMenuError" Foreground="{StaticResource DangerBrush}" TextWrapping="Wrap" Margin="0,0,0,8"/>
                    <Button Content="Change the staff PIN" Style="{StaticResource BaseButton}" Click="ChangePin_Click" Margin="0,0,0,12"/>
                    <Button Content="Unpair this computer" Style="{StaticResource BaseButton}" Click="ChangeComputer_Click" Margin="0,0,0,12"/>
                    <Button Content="Exit the kiosk" Style="{StaticResource DangerButton}" Click="ExitKiosk_Click" Margin="0,0,0,12"/>
                    <Button Content="Back" Style="{StaticResource BaseButton}" Click="StaffCancel_Click"/>
                </StackPanel>

                <!-- Staff menu: change the staff PIN (saved as a hash) -->
                <StackPanel x:Name="ChangePinPanel" Visibility="Collapsed">
                    <TextBlock Text="Change the staff PIN" FontSize="30" FontWeight="Bold"/>
                    <TextBlock Text="At least 4 characters. It is saved only as a hash in kiosk.settings.json."
                               FontSize="16" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,4,0,16"/>
                    <TextBlock Text="New PIN" FontWeight="Medium" Margin="0,0,0,4"/>
                    <PasswordBox x:Name="NewPinBox"/>
                    <TextBlock Text="New PIN again" FontWeight="Medium" Margin="0,12,0,4"/>
                    <PasswordBox x:Name="NewPinAgainBox" KeyDown="NewPinAgainBox_KeyDown"/>
                    <TextBlock x:Name="ChangePinError" Foreground="{StaticResource DangerBrush}" TextWrapping="Wrap" Margin="0,8,0,0"/>
                    <Grid Margin="0,16,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0" Content="Back" Style="{StaticResource BaseButton}" Click="BackToStaffMenu_Click"/>
                        <Button Grid.Column="2" Content="Save PIN" Style="{StaticResource PrimaryButton}" Click="SavePin_Click"/>
                    </Grid>
                </StackPanel>

            </Grid>
        </Border>
    </Grid>
</Window>
